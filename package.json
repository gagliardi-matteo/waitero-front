{
  "name": "front",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/prepare-prod-environment.mjs",
    "dev": "ng serve --configuration development --proxy-config proxy.conf.json",
    "start:local": "ng serve --configuration development --proxy-config proxy.conf.json",
    "ng": "ng",
    "build": "ng build --configuration production",
    "build:mobile": "npm run build:mobile:prod",
    "sync:mobile": "npx cap sync",
    "open:ios": "npx cap open ios",
    "open:android": "npx cap open android",
    "assets:mobile": "npx capacitor-assets generate --iconBackgroundColor=#d87a2c --iconBackgroundColorDark=#d87a2c --splashBackgroundColor=#fbf8f3 --splashBackgroundColorDark=#24272f",
    "build:ssr": "vite build && tsc --project tsconfig.server.json",
    "start": "node dist/server/server.js",
    "build:mobile:lan": "npm run build:mobile:dev",
    "build:mobile:prod": "cross-env WAITERO_MOBILE_CHANNEL=prod node scripts/validate-mobile-production-url.mjs && npm run _build:mobile:prod",
    "_build:mobile:prod": "node scripts/prepare-mobile-native-config.mjs && node scripts/prepare-mobile-brand-assets.mjs && npm run assets:mobile && node scripts/prepare-mobile-prod-environment.mjs && ng build --configuration mobile-prod && npx cap sync",
    "build:mobile:dev": "cross-env WAITERO_MOBILE_CHANNEL=dev WAITERO_MOBILE_LAN=true npm run _build:mobile:dev",
    "_build:mobile:dev": "node scripts/prepare-mobile-native-config.mjs && node scripts/prepare-mobile-brand-assets.mjs && npm run assets:mobile && node scripts/prepare-mobile-lan-environment.mjs && ng build --configuration mobile-dev && npx cap sync"
  },
  "private": true,
  "dependencies": {
    "@abacritt/angularx-social-login": "^2.4.0",
    "@angular/animations": "^19.2.14",
    "@angular/common": "^19.2.14",
    "@angular/compiler": "^19.2.14",
    "@angular/core": "^19.2.14",
    "@angular/forms": "^19.2.14",
    "@angular/platform-browser": "^19.2.14",
    "@angular/platform-browser-dynamic": "^19.2.14",
    "@angular/platform-server": "^19.2.14",
    "@angular/router": "^19.2.14",
    "@angular/ssr": "^19.2.15",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.1",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/splash-screen": "^7.0.5",
    "@capacitor/status-bar": "^7.0.6",
    "@fingerprintjs/fingerprintjs": "^5.1.0",
    "express": "^4.18.2",
    "jwt-decode": "^4.0.0",
    "lucide-angular": "^0.515.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^1.17.1",
    "@angular-devkit/build-angular": "^19.2.15",
    "@angular/cli": "^19.2.15",
    "@angular/compiler-cli": "^19.2.14",
    "@capacitor/android": "^7.6.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.6.1",
    "@capacitor/ios": "^7.6.1",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^18.19.130",
    "@types/qrcode": "^1.5.6",
    "cross-env": "^7.0.3",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.5.2",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
